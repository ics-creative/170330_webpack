{
  "compilerOptions": {
    // 厳密モードとして設定
    "strict": true,
    // ソースマップを有効化
    "sourceMap": true,
    // TSはECMAScript 5に変換
    "target": "ES5",
    "ignoreDeprecations": "6.0",
    // TSのモジュールはES Modulesとして出力
    "module": "ES2015",
    // Vueパッケージの型解決に必要な指定
    "allowSyntheticDefaultImports": true,
    "lib": [
      "DOM",
      "ES2020"
    ],
    "moduleResolution": "bundler"
  }
}
